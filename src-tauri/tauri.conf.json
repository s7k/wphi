{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WPHI",
  "identifier": "dev.wphi",
  "version": "0.1.31",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WPHI",
        "width": 800,
        "height": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "map",
        "title": "マップ",
        "url": "map.html",
        "width": 437,
        "height": 481,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "eagleeye",
        "title": "イーグルアイ",
        "url": "eagleeye.html",
        "width": 496,
        "height": 520,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http: https: data: phi-asset: http://phi-asset.localhost; media-src 'self' phi-asset: http://phi-asset.localhost; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/phi/PCGL.txt": "licenses/PCGL.txt",
      "../resources/phi/PCGL.utf8.txt": "licenses/PCGL.utf8.txt",
      "../resources/phi/README.md": "licenses/GRAPHICS.md"
    },
    "category": "Game",
    "shortDescription": "PHI のクライアント",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
