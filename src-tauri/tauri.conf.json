{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Philly",
  "identifier": "dev.rust-philly",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Philly",
        "width": 800,
        "height": 600
      },
      {
        "label": "map",
        "title": "マップ",
        "url": "map.html",
        "width": 240,
        "height": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http: https: data: phi-asset: http://phi-asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/phi/": "phi/"
    }
  }
}
